{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "baseUrl": "src",
    "paths": {
      "@cyopo/App/*":        ["common/app/*"],
      "@cyopo/Components/*": ["common/components/*"],
      "@cyopo/Constants/*":  ["common/constants/*"],
      "@cyopo/Hooks/*":      ["common/hooks/*"],
      "@cyopo/Models/*":     ["common/models/*"],
      "@cyopo/Services/*":   ["common/services/*"],
      "@cyopo/Theme/*":      ["common/theme/*"],
      "@cyopo/Utils/*":      ["common/utils/*"],
      "@cyopo/Redux/*":      ["common/redux/*"],
      "@cyopo/Pages/*":      ["pages/*"],
      "@cyopo/Mock/*":       ["test/mock/*"]
    }
  },
  "include": ["src"]
}